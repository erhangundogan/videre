{
  "_comment": "Source of truth for the videre gallery HTTP endpoints. tests/docs_routes.rs asserts this manifest matches the .route(...) calls in report.rs exactly (both directions), so any change to the router or this file that is not mirrored fails the build. 'gallery: true' means the endpoint is served by `videre gallery` (the only shipping config); 'gallery: false' entries are defined in report.rs but only reachable in the vestigial labeling-only config, and docs must not name them. Params are written {id}/{name}.",
  "endpoints": [
    { "method": "GET",  "path": "/api/face-image/{id}",     "gallery": true },
    { "method": "GET",  "path": "/api/original-image/{id}", "gallery": true },
    { "method": "GET",  "path": "/api/cluster/{id}",        "gallery": true },
    { "method": "GET",  "path": "/api/person/{name}",       "gallery": true },
    { "method": "GET",  "path": "/api/search/person",       "gallery": true },
    { "method": "POST", "path": "/api/quit",                "gallery": true },
    { "method": "GET",  "path": "/api/location",            "gallery": true },
    { "method": "GET",  "path": "/api/raw",                 "gallery": true },
    { "method": "GET",  "path": "/api/files",               "gallery": true },
    { "method": "POST", "path": "/api/mark",                "gallery": true },
    { "method": "GET",  "path": "/api/dates",               "gallery": true },
    { "method": "GET",  "path": "/api/search",              "gallery": true },
    { "method": "GET",  "path": "/api/faces",               "gallery": true },
    { "method": "POST", "path": "/api/assign",              "gallery": true },
    { "method": "POST", "path": "/api/new-person",          "gallery": true },
    { "method": "POST", "path": "/api/remove-face",         "gallery": true },
    { "method": "POST", "path": "/api/delete-person",       "gallery": true },
    { "method": "POST", "path": "/api/set-full-name",       "gallery": true },
    { "method": "POST", "path": "/api/dissolve-cluster",    "gallery": true },
    { "method": "POST", "path": "/api/set-primary",         "gallery": true },
    { "method": "GET",  "path": "/",                        "gallery": true },
    { "method": "GET",  "path": "/duplicates",              "gallery": true },
    { "method": "GET",  "path": "/people",                  "gallery": true },
    { "method": "GET",  "path": "/date",                    "gallery": true },
    { "method": "GET",  "path": "/map",                     "gallery": true },
    { "method": "GET",  "path": "/events",                  "gallery": true },
    { "method": "GET",  "path": "/smart",                   "gallery": true },
    { "method": "GET",  "path": "/people/cluster/{id}",     "gallery": true },
    { "method": "GET",  "path": "/people/person/{name}",    "gallery": true },
    { "method": "GET",  "path": "/faces",                   "gallery": false },
    { "method": "GET",  "path": "/cluster/{id}",            "gallery": false },
    { "method": "GET",  "path": "/person/{name}",           "gallery": false }
  ]
}

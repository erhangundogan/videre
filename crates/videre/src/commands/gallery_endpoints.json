{
  "_comment": "Source of truth for the videre gallery HTTP endpoints. tests/docs_routes.rs asserts this manifest matches the .route(...) calls in report.rs exactly (both directions), and that the static JS only calls declared endpoints, so any drift fails the build. Params are written {id}/{name}/{hash}.",
  "endpoints": [
    { "method": "GET",    "path": "/api/files" },
    { "method": "PATCH",  "path": "/api/files/{hash}" },
    { "method": "GET",    "path": "/api/files/{hash}/raw" },
    { "method": "GET",    "path": "/api/dates" },
    { "method": "GET",    "path": "/api/search" },
    { "method": "GET",    "path": "/api/locations" },
    { "method": "GET",    "path": "/api/people" },
    { "method": "POST",   "path": "/api/people" },
    { "method": "GET",    "path": "/api/people/{name}" },
    { "method": "PATCH",  "path": "/api/people/{name}" },
    { "method": "DELETE", "path": "/api/people/{name}" },
    { "method": "PUT",    "path": "/api/people/{name}/faces" },
    { "method": "GET",    "path": "/api/faces" },
    { "method": "PATCH",  "path": "/api/faces/{id}" },
    { "method": "DELETE", "path": "/api/faces/{id}" },
    { "method": "GET",    "path": "/api/faces/{id}/image" },
    { "method": "GET",    "path": "/api/faces/{id}/original" },
    { "method": "GET",    "path": "/api/clusters/{id}" },
    { "method": "DELETE", "path": "/api/clusters/{id}" },
    { "method": "POST",   "path": "/api/quit" },
    { "method": "GET",    "path": "/" },
    { "method": "GET",    "path": "/duplicates" },
    { "method": "GET",    "path": "/people" },
    { "method": "GET",    "path": "/date" },
    { "method": "GET",    "path": "/map" },
    { "method": "GET",    "path": "/events" },
    { "method": "GET",    "path": "/smart" },
    { "method": "GET",    "path": "/people/cluster/{id}" },
    { "method": "GET",    "path": "/people/person/{name}" }
  ]
}

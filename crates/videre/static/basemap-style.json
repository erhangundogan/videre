{
  "version": 8,
  "name": "videre-offline-basemap",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles:///tiles/basemap.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#aadaff" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "basemap",
      "source-layer": "earth",
      "paint": { "fill-color": "#f2efe9" }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "basemap",
      "source-layer": "land",
      "paint": { "fill-color": "#ebe8e1", "fill-opacity": 0.6 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "paint": { "fill-color": "#eeece5", "fill-opacity": 0.5 }
    },
    {
      "id": "natural",
      "type": "fill",
      "source": "basemap",
      "source-layer": "natural",
      "paint": { "fill-color": "#c8e6c9", "fill-opacity": 0.8 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": { "fill-color": "#aadaff" }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#b0b0b0",
        "line-opacity": 0.8,
        "line-width": 0.9
      }
    }
  ]
}
